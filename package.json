{
  "name": "@xshieldai/aegis",
  "version": "2.27.2",
  "description": "AEGIS / KavachOS — Agentic runtime governance: budget enforcement, DAN gate (human-in-loop), seccomp-bpf kernel enforcement, Falco anomaly detection + Agentic Control Center (cockpit page rendering all @rocketlang/* primitive events in one view, PRAMANA Merkle audit, per-agent timeline).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "bun": "./index.ts",
      "import": "./lib/index.js"
    },
    "./lite": {
      "types": "./src/sdk/lite.ts",
      "bun": "./src/sdk/lite.ts",
      "import": "./lib/src/sdk/lite.js"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "bun": "./src/sdk/index.ts",
      "import": "./lib/src/sdk/index.js"
    },
    "./acc/bus": {
      "types": "./src/acc/bus.ts",
      "bun": "./src/acc/bus.ts",
      "import": "./lib/src/acc/bus.js"
    },
    "./acc/types": {
      "types": "./src/acc/types.ts",
      "bun": "./src/acc/types.ts",
      "import": "./lib/src/acc/types.js"
    }
  },
  "author": "Capt. Anil Sharma <capt.anil.sharma@powerpbox.org>",
  "homepage": "https://github.com/rocketlang/aegis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocketlang/aegis.git"
  },
  "bugs": {
    "url": "https://github.com/rocketlang/aegis/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "governance",
    "budget",
    "cost-control",
    "claude-code",
    "openai-codex",
    "finops",
    "ai-spend",
    "agentic",
    "kill-switch",
    "anthropic",
    "openai"
  ],
  "bin": {
    "aegis": "bin/aegis.js",
    "aegis-monitor": "bin/aegis-monitor.js",
    "aegis-dashboard": "bin/aegis-dashboard.js",
    "kavachos": "bin/kavachos.js"
  },
  "files": [
    "lib/",
    "bin/",
    "src/",
    "index.ts",
    "docs/",
    "rules/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "monitor": "bun run src/monitor/index.ts",
    "dashboard": "bun run src/dashboard/server.ts",
    "cli": "bun run src/cli/index.ts",
    "kavachos": "bun run src/kavachos-cli.ts",
    "start": "bun run src/monitor/index.ts & bun run src/dashboard/server.ts",
    "test:agents": "bun src/test-agents/runner.ts",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "build:node": "rm -rf lib && bun build index.ts src/sdk/lite.ts src/sdk/index.ts src/acc/bus.ts src/acc/types.ts --target=node --format=esm --splitting --packages=external --outdir=lib --root=."
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.6",
    "@xshieldai/aegis-guard": "^0.6.0",
    "@xshieldai/chitta-detect": "^0.3.0",
    "@xshieldai/hanumang-mandate": "^0.4.0",
    "@xshieldai/lakshmanrekha": "^0.4.0",
    "fastify": "^5.12.5",
    "show-me-the-receipts": "0.5.0"
  },
  "optionalDependencies": {
    "@ankr/approve": "0.2.0",
    "@ankr/mask-authorize": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
